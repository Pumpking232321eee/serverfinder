-- Track active teleport to prevent multiple attempts
local isTeleporting = false

local function createServerEntry(serverData, rank)
    local clone = ServerFrameTemplate:Clone()
    clone.Name = "ServerFrameClone"
    clone.Visible = true
    clone.Parent = ServerListFrame
    clone.BackgroundTransparency = 1
    clone.LayoutOrder = rank

    local nameLabel = clone:FindFirstChild("ServerName")
    nameLabel.Text = string.sub(serverData.id, 1, 8)

    local playersLabel = clone:FindFirstChild("ServerPlayers")
    playersLabel.Text = serverData.playing .. "/" .. serverData.maxPlayers

    local pingLabel = clone:FindFirstChild("ServerPing")
    local ping = math.floor(tonumber(serverData.ping) or 0)
    pingLabel.Text = ping .. "ms ping"
    if ping <= 80 then
        pingLabel.TextColor3 = Color3.fromRGB(90, 200, 120)
    elseif ping <= 150 then
        pingLabel.TextColor3 = Color3.fromRGB(230, 190, 80)
    else
        pingLabel.TextColor3 = Color3.fromRGB(230, 90, 90)
    end

    -- Store server info on the clone for later use
    clone:SetAttribute("ServerId", serverData.id)
    clone:SetAttribute("IsJoining", false)

    local joinBtn = clone:FindFirstChild("JoinButton")
    joinBtn.MouseButton1Click:Connect(function()
        -- Prevent multiple teleport attempts
        if isTeleporting then return end
        if clone:GetAttribute("IsJoining") then return end
        
        clone:SetAttribute("IsJoining", true)
        joinBtn.Text = "Joining...."
        joinBtn.BackgroundColor3 = Color3.fromRGB(200, 160, 50)
        joinBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        
        local serverId = clone:GetAttribute("ServerId")
        local success, err = pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, serverId, LocalPlayer)
        end)
        
        -- Reset button state after teleport attempt (or if it fails)
        wait(0.5)
        clone:SetAttribute("IsJoining", false)
        joinBtn.Text = "JOIN"
        joinBtn.BackgroundColor3 = SUCCESS
        joinBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        
        if not success then
            -- Teleport failed, show a brief error message in footer
            FooterText.Text = "Failed to join: " .. (err or "Server may be full")
            FooterText.TextColor3 = Color3.fromRGB(230, 90, 90)
            wait(3)
            FooterText.Text = CountBadge.Text .. " server" .. (tonumber(CountBadge.Text) == 1 and "" or "s") .. " found"
            FooterText.TextColor3 = TEXT_SUB
        end
    end)

    TweenService:Create(clone, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        BackgroundTransparency = 0
    }):Play()
end

local function fetchServers(cursor)
    local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", game.PlaceId)
    if cursor then
        url = url .. "&cursor=" .. cursor
    end
    local success, response = pcall(function()
        return requestFunc({ Url = url, Method = "GET" })
    end)
    if success and response and response.Body then
        local success2, data = pcall(function()
            return HttpService:JSONDecode(response.Body)
        end)
        if success2 then
            return data
        end
    end
    return nil
end

local isLoading = false

local function loadServersFast(showLoading)
    if isLoading then return end
    isLoading = true

    -- Clear old entries
    for _, child in ipairs(ServerListFrame:GetChildren()) do
        if child.Name == "ServerFrameClone" then
            child:Destroy()
        end
    end

    if showLoading then
        LoadingText.Visible = true
        LoadingText.Text = "Getting Servers..."
        FooterText.Text = "Searching..."
        FooterText.TextColor3 = TEXT_SUB
    end

    local servers = {}
    local cursor = nil
    local pageCount = 0
    local maxPages = 1

    local fetchSuccess = true
    repeat
        local data = fetchServers(cursor)
        if data and data.data then
            for _, server in ipairs(data.data) do
                table.insert(servers, server)
            end
            cursor = data.nextPageCursor
            pageCount = pageCount + 1
        else
            fetchSuccess = false
            break
        end
    until not cursor or pageCount >= maxPages

    LoadingText.Visible = false

    if not fetchSuccess then
        FooterText.Text = "Error fetching servers"
        FooterText.TextColor3 = Color3.fromRGB(230, 90, 90)
        CountBadge.Text = "0"
        isLoading = false
        return
    end

    local displayQueue = {}
    for _, server in ipairs(servers) do
        if server.playing == 1 then
            table.insert(displayQueue, server)
        end
    end

    table.sort(displayQueue, function(a, b)
        return (tonumber(a.ping) or 999) < (tonumber(b.ping) or 999)
    end)

    CountBadge.Text = tostring(#displayQueue)

    if #displayQueue > 0 then
        for i, server in ipairs(displayQueue) do
            createServerEntry(server, i)
        end
        FooterText.Text = #displayQueue .. " server" .. (#displayQueue == 1 and "" or "s") .. " found"
        FooterText.TextColor3 = TEXT_SUB
    else
        FooterText.Text = "No 1-player servers found"
        FooterText.TextColor3 = TEXT_SUB
    end

    isLoading = false
end

Refresh.MouseButton1Click:Connect(function()
    Refresh.Text = "Refreshing..."
    spawn(function()
        wait(0.5)
        Refresh.Text = "Refresh"
    end)

    -- Force reset loading state and clear list
    isLoading = false
    isTeleporting = false

    for _, child in ipairs(ServerListFrame:GetChildren()) do
        if child.Name == "ServerFrameClone" then
            child:Destroy()
        end
    end

    spawn(function()
        loadServersFast(true)
    end)
end)

