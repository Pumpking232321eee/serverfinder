local function createServerEntry(serverData, rank)
    local clone = ServerFrameTemplate:Clone()
    clone.Name = "ServerFrameClone"
    clone.Visible = true
    clone.Parent = ServerListFrame
    clone.BackgroundTransparency = 1
    
    -- Removed rank label, only show server name
    local nameLabel = clone:FindFirstChild("ServerName")
    local serverId = string.sub(serverData.id, 1, 8)
    nameLabel.Text = serverId
    
    local playersLabel = clone:FindFirstChild("ServerPlayers")
    playersLabel.Text = serverData.playing .. "/" .. serverData.maxPlayers
    
    local joinBtn = clone:FindFirstChild("JoinButton")
    joinBtn.MouseButton1Click:Connect(function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, serverData.id, LocalPlayer)
    end)
    
    local fadeIn = TweenService:Create(clone, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        BackgroundTransparency = 0
    })
    fadeIn:Play()
end

local function fetchServers(cursor)
    local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", game.PlaceId)
    if cursor then
        url = url .. "&cursor=" .. cursor
    end
    local response = requestFunc({
        Url = url,
        Method = "GET"
    })
    if response and response.Body then
        return HttpService:JSONDecode(response.Body)
    end
end

local isLoading = false
local isHoping = false

local function loadServers(showLoading)
    if isLoading then
        return
    end
    isLoading = true

    -- Clear existing servers
    for _, child in ipairs(ServerListFrame:GetChildren()) do
        if child.Name == "ServerFrameClone" then
            child:Destroy()
        end
    end
    
    -- Only show loading text if explicitly requested (initial load)
    if showLoading then
        LoadingText.Visible = true
        LoadingText.Text = "Getting Servers..."
    end
    
    local servers = {}
    local cursor = nil
    repeat
        local data = fetchServers(cursor)
        if data and data.data then
            for _, server in ipairs(data.data) do
                table.insert(servers, server)
            end
            cursor = data.nextPageCursor
        else
            break
        end
    until not cursor

    table.sort(servers, function(a, b)
        return a.playing < b.playing
    end)

    local displayQueue = {}
    for _, server in ipairs(servers) do
        if server.playing == 1 then
            table.insert(displayQueue, server)
        end
    end
    
    if #displayQueue > 0 then
        -- Hide loading text when first server appears
        LoadingText.Visible = false
        
        for i, server in ipairs(displayQueue) do
            createServerEntry(server, i)
            if i < #displayQueue then
                wait(0.5)
            end
        end
    else
        -- No servers found, show message
        LoadingText.Text = "No servers found"
        LoadingText.Visible = true
        wait(2)
        LoadingText.Visible = false
    end

    isLoading = false
end

-- Function to get all servers with 1 player
local function getOnePlayerServers()
    local servers = {}
    local cursor = nil
    repeat
        local data = fetchServers(cursor)
        if data and data.data then
            for _, server in ipairs(data.data) do
                if server.playing == 1 then
                    table.insert(servers, server)
                end
            end
            cursor = data.nextPageCursor
        else
            break
        end
    until not cursor
    return servers
end

-- Server Hop Button click handler (Simple 1-tap)
ServerHopButton.MouseButton1Click:Connect(function()
    -- Don't do anything if already hoping
    if isHoping then
        return
    end
    
    isHoping = true
    
    local foundServer = nil
    
    local success, errorMsg = pcall(function()
        local onePlayerServers = getOnePlayerServers()
        if #onePlayerServers > 0 then
            -- Pick a random 1 player server
            local randomIndex = math.random(1, #onePlayerServers)
            foundServer = onePlayerServers[randomIndex]
        end
    end)
    
    if not success then
        isHoping = false
        return
    end
    
    if foundServer then
        -- Check if the server is the current one
        local currentJobId = game.JobId
        if foundServer.id ~= currentJobId then
            -- Teleport to the found server
            pcall(function()
                TeleportService:TeleportToPlaceInstance(game.PlaceId, foundServer.id, LocalPlayer)
            end)
        end
        -- If it's the same server or teleport fails, just reset the button
        isHoping = false
    else
        -- No 1 player server found
        isHoping = false
    end
end)

